## 🔍 Monitoring & Alerting

### Health Check Monitoring
Comprehensive health checks:

```python
# In backend/api/routes/health.py
@router.get("/health")
def health_check():
    """Comprehensive system health check."""
    health_status = {
        "status": "healthy",
        "timestamp": datetime.utcnow().isoformat(),
        "version": "1.0.0",
        "components": {},
        "metrics": {}
    }
    
    # Check database
    try:
        job_store.health_check()
        health_status["components"]["database"] = "healthy"
    except Exception as e:
        health_status["components"]["database"] = f"unhealthy: {str(e)}"
        health_status["status"] = "degraded"
    
    # Check Redis
    try:
        redis_client.ping()
        health_status["components"]["redis"] = "healthy"
    except Exception:
        health_status["components"]["redis"] = "unavailable"
    
    # Check GPU
    gpu_available = check_gpu_availability()
    health_status["components"]["gpu"] = "available" if gpu_available else "unavailable"
    
    # Add metrics
    health_status["metrics"] = {
        "active_jobs": get_active_job_count(),
        "total_jobs": get_total_job_count(),
        "uptime_seconds": get_uptime_seconds(),
        "memory_usage_mb": get_memory_usage(),
        "disk_usage_gb": get_disk_usage()
    }
    
    return health_status
```

### Performance Monitoring
Track key performance indicators:

```python
class PerformanceMonitor:
    """Monitor system performance and resource usage."""
    
    def __init__(self):
        self.logger = get_logger("performance_monitor")
    
    def monitor_job_performance(self, job_id: str, workflow: str):
        """Monitor individual job performance."""
        start_time = time.time()
        start_memory = self.get_memory_usage()
        
        def log_completion(status: str, **kwargs):
            duration = time.time() - start_time
            memory_delta = self.get_memory_usage() - start_memory
            
            self.logger.info("Job performance summary", extra={
                "job_id": job_id,
                "workflow": workflow,
                "status": status,
                "duration_seconds": duration,
                "memory_delta_mb": memory_delta,
                **kwargs
            })
            
            # Update Prometheus metrics
            job_duration.labels(workflow=workflow).observe(duration)
            job_counter.labels(workflow=workflow, status=status).inc()
        
        return log_completion
    
    def monitor_system_resources(self):
        """Monitor overall system resources."""
        metrics = {
            "cpu_percent": psutil.cpu_percent(),
            "memory_percent": psutil.virtual_memory().percent,
            "disk_percent": psutil.disk_usage('/').percent,
            "active_jobs": get_active_job_count(),
            "queue_length": get_job_queue_length()
        }
        
        self.logger.info("System resources", extra=metrics)
        
        # Update Prometheus gauges
        for metric, value in metrics.items():
            if hasattr(self, f"{metric}_gauge"):
                getattr(self, f"{metric}_gauge").set(value)
        
        return metrics
```

### Alert Configuration
Define alerting rules for critical conditions:

```python
class AlertManager:
    """Manage system alerts and notifications."""
    
    def __init__(self):
        self.logger = get_logger("alerts")
        self.webhook_url = config.webhook_url
    
    def check_alert_conditions(self):
        """Check for alert conditions."""
        alerts = []
        
        # High error rate
        error_rate = self.get_error_rate_last_hour()
        if error_rate > 0.05:  # 5% error rate
            alerts.append({
                "severity": "warning",
                "message": f"High error rate: {error_rate:.2%}",
                "metric": "error_rate",
                "value": error_rate,
                "threshold": 0.05
            })
        
        # High memory usage
        memory_usage = psutil.virtual_memory().percent
        if memory_usage > 85:
            alerts.append({
                "severity": "critical" if memory_usage > 95 else "warning",
                "message": f"High memory usage: {memory_usage:.1f}%",
                "metric": "memory_usage",
                "value": memory_usage,
                "threshold": 85
            })
        
        # Long queue length
        queue_length = get_job_queue_length()
        if queue_length > 50:
            alerts.append({
                "severity": "warning",
                "message": f"Long job queue: {queue_length} jobs",
                "metric": "queue_length", 
                "value": queue_length,
                "threshold": 50
            })
        
        # Process alerts
        for alert in alerts:
            self.process_alert(alert)
    
    def process_alert(self, alert: dict):
        """Process and send alert."""
        self.logger.warning(f"ALERT: {alert['message']}", extra=alert)
        
        if self.webhook_url:
            self.send_webhook_alert(alert)
    
    def send_webhook_alert(self, alert: dict):
        """Send alert via webhook."""
        try:
            payload = {
                "timestamp": datetime.utcnow().isoformat(),
                "service": "ai-video-generator",
                "alert": alert
            }
            
            response = requests.post(
                self.webhook_url,
                json=payload,
                timeout=10
            )
            response.raise_for_status()
            
        except Exception as e:
            self.logger.error(f"Failed to send webhook alert: {e}")
```

## 📊 Log Analysis & Debugging

### Log Parsing and Analysis
Analyze logs for patterns and issues:

```python
import json
import re
from collections import defaultdict, Counter

class LogAnalyzer:
    """Analyze application logs for insights."""
    
    def analyze_job_performance(self, log_file: str, hours: int = 24):
        """Analyze job performance from logs."""
        job_stats = defaultdict(list)
        error_patterns = Counter()
        
        with open(log_file, 'r') as f:
            for line in f:
                try:
                    log_entry = json.loads(line)
                    
                    # Extract job performance data
                    if 'job_id' in log_entry:
                        job_id = log_entry['job_id']
                        
                        if 'duration_seconds' in log_entry:
                            job_stats[job_entry['workflow']].append({
                                'job_id': job_id,
                                'duration': log_entry['duration_seconds'],
                                'status': log_entry.get('status', 'unknown')
                            })
                    
                    # Track error patterns
                    if log_entry.get('levelname') == 'ERROR':
                        error_msg = log_entry.get('message', '')
                        # Extract error pattern
                        pattern = re.sub(r'\b\d+\b', 'N', error_msg)  # Replace numbers
                        error_patterns[pattern] += 1
                        
                except (json.JSONDecodeError, KeyError):
                    continue
        
        return {
            'job_performance': dict(job_stats),
            'error_patterns': dict(error_patterns.most_common(10))
        }
    
    def generate_performance_report(self, analysis: dict):
        """Generate human-readable performance report."""
        report = ["=== AI Video Generator Performance Report ===\n"]
        
        for workflow, jobs in analysis['job_performance'].items():
            if not jobs:
                continue
                
            durations = [j['duration'] for j in jobs]
            success_rate = len([j for j in jobs if j['status'] == 'completed']) / len(jobs)
            
            report.append(f"Workflow: {workflow}")
            report.append(f"  Total jobs: {len(jobs)}")
            report.append(f"  Success rate: {success_rate:.1%}")
            report.append(f"  Avg duration: {sum(durations)/len(durations):.1f}s")
            report.append(f"  Min duration: {min(durations):.1f}s")
            report.append(f"  Max duration: {max(durations):.1f}s\n")
        
        if analysis['error_patterns']:
            report.append("Top Error Patterns:")
            for pattern, count in analysis['error_patterns'].items():
                report.append(f"  {count:3d}x: {pattern}")
        
        return "\n".join(report)
```

