## 🚀 Performance Optimization

### Code Splitting
Use React.lazy for route-based code splitting:

```tsx
import { lazy, Suspense } from 'react'

const CreatorPage = lazy(() => import('./pages/CreatorPage'))
const CompilationsPage = lazy(() => import('./pages/CompilationsPage'))

function App() {
  return (
    <Suspense fallback={<div>Loading...</div>}>
      <Routes>
        <Route path="/creator" element={<CreatorPage />} />
        <Route path="/compilations" element={<CompilationsPage />} />
      </Routes>
    </Suspense>
  )
}
```

### Memo and Callbacks
Use React.memo and useCallback for expensive operations:

```tsx
import { memo, useCallback, useMemo } from 'react'

const ExpensiveComponent = memo(({ data, onUpdate }) => {
  const processedData = useMemo(() => {
    return data.map(item => processItem(item))
  }, [data])
  
  const handleUpdate = useCallback((id: string) => {
    onUpdate(id)
  }, [onUpdate])
  
  return (
    // Component JSX
  )
})
```

Always follow these patterns for consistency and maintainability across the frontend codebase.