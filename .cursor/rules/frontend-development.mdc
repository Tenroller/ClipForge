### Component Structure
Follow this pattern for all React components:

```tsx
import { useState, useEffect } from 'react'
import { Button } from '@/components/components/ui/button'
import { useJobManager } from '@/hooks/useJobManager'

interface ComponentProps {
  title: string
  onComplete?: () => void
}

export default function MyComponent({ title, onComplete }: ComponentProps) {
  const [loading, setLoading] = useState(false)
  const jobManager = useJobManager()

  const handleAction = async () => {
    setLoading(true)
    try {
      // Component logic
      await performAction()
      onComplete?.()
    } catch (error) {
      console.error('Action failed:', error)
    } finally {
      setLoading(false)
    }
  }

  return (
    <div className="space-y-4">
      <h2 className="text-xl font-semibold">{title}</h2>
      <Button 
        onClick={handleAction} 
        disabled={loading}
        className="w-full"
      >
        {loading ? 'Processing...' : 'Start Action'}
      </Button>
    </div>
  )
}
```

## 🎯 State Management

### Job Management Hook
Use the centralized job manager from [frontend/src/hooks/useJobManager.ts](mdc:frontend/src/hooks/useJobManager.ts):

```tsx
import { useJobManager } from '@/hooks/useJobManager'

function VideoCreator() {
  const jobManager = useJobManager()
  
  // Get active jobs
  const activeJobs = jobManager.getActiveJobs()
  
  // Start a new job
  const handleGenerate = async (params: VideoParams) => {
    const response = await fetch('/api/moneyprinter/generate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(params)
    })
    
    const { job_id } = await response.json()
    jobManager.startTracking(job_id)
  }
  
  return (
    <div>
      {activeJobs.map(job => (
        <JobProgress key={job.id} job={job} />
      ))}
    </div>
  )
}
```

