## 🔄 API Integration

### API Configuration
Use the environment-based API configuration from [frontend/src/App.tsx](mdc:frontend/src/App.tsx):

```tsx
const API = (import.meta.env.VITE_API_BASE as string) || 'http://localhost:8080'

// API calls
const response = await fetch(`${API}/api/endpoint`, {
  method: 'POST',
  headers: {
    'Content-Type': 'application/json',
    'X-API-Key': apiKey // if required
  },
  body: JSON.stringify(data)
})
```

### Error Handling
Implement consistent error handling:

```tsx
import { toast } from 'sonner'

async function apiCall() {
  try {
    const response = await fetch('/api/endpoint')
    
    if (!response.ok) {
      throw new Error(`HTTP ${response.status}: ${response.statusText}`)
    }
    
    const data = await response.json()
    
    if (!data.success) {
      throw new Error(data.error?.message || 'Operation failed')
    }
    
    return data
  } catch (error) {
    console.error('API call failed:', error)
    toast.error(error instanceof Error ? error.message : 'Unknown error')
    throw error
  }
}
```

## 🔌 Real-time Updates

### WebSocket Integration
Implement WebSocket connections for real-time job updates:

```tsx
import { useEffect, useRef } from 'react'

function useWebSocket(jobId: string, onUpdate: (data: any) => void) {
  const wsRef = useRef<WebSocket | null>(null)
  
  useEffect(() => {
    if (!jobId) return
    
    const ws = new WebSocket(`ws://localhost:8080/ws`)
    wsRef.current = ws
    
    ws.onopen = () => {
      ws.send(JSON.stringify({ type: 'subscribe', job_id: jobId }))
    }
    
    ws.onmessage = (event) => {
      const data = JSON.parse(event.data)
      onUpdate(data)
    }
    
    ws.onerror = (error) => {
      console.error('WebSocket error:', error)
    }
    
    return () => {
      ws.close()
    }
  }, [jobId, onUpdate])
  
  return wsRef.current
}
```

## 📱 Responsive Design

### Mobile-First Approach
Design for mobile first, then enhance for desktop:

```tsx
<div className="
  flex flex-col gap-4 p-4
  lg:flex-row lg:gap-6 lg:p-6
  xl:gap-8 xl:p-8
">
  {/* Mobile: stacked, Desktop: side-by-side */}
</div>

// Mobile sidebar
<div className="lg:hidden fixed inset-0 z-50 bg-background/80 backdrop-blur-sm">
  <SidebarRouter
    isCollapsed={false}
    onToggleCollapse={() => setShowMobileSidebar(false)}
    className="w-64"
  />
</div>
```

### Breakpoint Usage
Follow Tailwind's breakpoint system:
- `sm:` - 640px and up
- `md:` - 768px and up  
- `lg:` - 1024px and up
- `xl:` - 1280px and up

## 🧪 Component Testing

### Testing Patterns
Test components with user interactions:

```tsx
import { render, screen, fireEvent } from '@testing-library/react'
import { BrowserRouter } from 'react-router-dom'
import MyComponent from './MyComponent'

function renderWithRouter(component: React.ReactElement) {
  return render(
    <BrowserRouter>
      {component}
    </BrowserRouter>
  )
}

test('component handles user interaction', async () => {
  renderWithRouter(<MyComponent title="Test" />)
  
  const button = screen.getByRole('button', { name: /start action/i })
  fireEvent.click(button)
  
  expect(screen.getByText(/processing/i)).toBeInTheDocument()
})
```

