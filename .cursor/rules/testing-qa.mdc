```python
import pytest
import time
from backend.database import get_job_store

def test_complete_video_generation_workflow(authenticated_headers):
    """Test complete video generation from start to finish."""
    # Step 1: Start video generation
    response = client.post(
        "/api/moneyprinter/generate",
        json={
            "videoSubject": "Test integration subject",
            "aiModel": "gemini-2.0-flash",
            "voice": "af_bella",
            "paragraphNumber": 1
        },
        headers=authenticated_headers
    )
    
    assert response.status_code == 200
    job_id = response.json()["job_id"]
    
    # Step 2: Monitor job progress
    max_wait_time = 300  # 5 minutes
    start_time = time.time()
    
    while time.time() - start_time < max_wait_time:
        status_response = client.get(
            f"/api/jobs/{job_id}",
            headers=authenticated_headers
        )
        
        job_data = status_response.json()
        status = job_data["status"]
        
        if status in ["completed", "failed"]:
            break
            
        time.sleep(5)  # Wait 5 seconds between checks
    
    # Step 3: Verify final status
    assert status == "completed", f"Job failed or timed out: {job_data}"
    assert "results" in job_data
    assert job_data["results"]["video_path"]

