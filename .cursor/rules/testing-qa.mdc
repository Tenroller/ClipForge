### Input Validation Testing
Test Pydantic models and validation:

```python
import pytest
from pydantic import ValidationError
from backend.models.requests import MoneyPrinterRequest, BrainrotRequest

def test_moneyprinter_request_validation():
    """Test MoneyPrinter request validation."""
    # Valid request
    valid_request = MoneyPrinterRequest(
        videoSubject="Valid subject with enough characters",
        aiModel="gemini-2.0-flash",
        voice="af_bella"
    )
    assert valid_request.videoSubject == "Valid subject with enough characters"
    
    # Invalid subject (too short)
    with pytest.raises(ValidationError) as exc_info:
        MoneyPrinterRequest(videoSubject="Short")
    
    assert "at least 10 characters" in str(exc_info.value)

def test_brainrot_request_validation():
    """Test Brainrot request validation."""
    # Valid YouTube URL
    valid_request = BrainrotRequest(
        youtubeUrl="https://youtube.com/watch?v=dQw4w9WgXcQ"
    )
    assert valid_request.youtubeUrl.startswith("https://youtube.com")
    
    # Invalid URL
    with pytest.raises(ValidationError):
        BrainrotRequest(youtubeUrl="not-a-youtube-url")
```

### Database Testing
Test database operations and job persistence:

```python
import pytest
from backend.database import JobStore
from backend.core.config import AppConfig

@pytest.fixture
def job_store():
    """Test job store with in-memory database."""
    config = AppConfig(database_url="sqlite:///:memory:")
    store = JobStore(config)
    store.init_database()
    return store

def test_job_creation(job_store):
    """Test job creation and retrieval."""
    job_id = "test-job-123"
    job_data = {
        "workflow": "moneyprinter",
        "status": "queued",
        "parameters": {"videoSubject": "Test"}
    }
    
    # Create job
    job_store.create_job(job_id, **job_data)
    
    # Retrieve job
    retrieved_job = job_store.get_job(job_id)
    assert retrieved_job["id"] == job_id
    assert retrieved_job["workflow"] == "moneyprinter"
    assert retrieved_job["status"] == "queued"

def test_job_progress_updates(job_store):
    """Test job progress tracking."""
    job_id = "progress-test-123"
    
    # Create initial job
    job_store.create_job(job_id, "moneyprinter", "queued", {})
    
    # Update progress
    job_store.update_job_progress(job_id, 50, "Processing video")
    
    # Check updated values
    job = job_store.get_job(job_id)
    assert job["progress"] == 50
    assert job["current_step"] == "Processing video"

def test_job_listing_and_filtering(job_store):
    """Test job listing with filters."""
    # Create multiple jobs
    for i in range(5):
        job_store.create_job(f"job-{i}", "moneyprinter", "completed" if i < 3 else "failed", {})
    
    # List all jobs
    all_jobs = job_store.list_jobs(limit=10)
    assert len(all_jobs) == 5
    
    # Filter by status
    completed_jobs = job_store.list_jobs(status="completed")
    assert len(completed_jobs) == 3
    
    failed_jobs = job_store.list_jobs(status="failed")
    assert len(failed_jobs) == 2
```

