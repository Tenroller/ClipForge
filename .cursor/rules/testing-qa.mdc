### Error Handling Testing
Test error scenarios and recovery:

```python
from backend.utils.error_handling import handle_error, VideoHelperError

def test_custom_error_handling():
    """Test custom VideoHelperError handling."""
    error = VideoHelperError(
        message="Test error",
        error_code="TEST_ERROR",
        details={"context": "testing"}
    )
    
    result = handle_error(error, log_error=False)
    
    assert not result["success"]
    assert result["error"]["error_code"] == "TEST_ERROR"
    assert result["error"]["message"] == "Test error"

def test_standard_exception_handling():
    """Test standard exception handling."""
    error = ValueError("Invalid input")
    
    result = handle_error(error, log_error=False)
    
    assert not result["success"]
    assert result["error"]["message"] == "Invalid input"
    assert "VALIDATION_ERROR" in result["error"]["error_code"]

def test_api_error_responses(authenticated_headers):
    """Test API error response formats."""
    # Test invalid request data
    response = client.post(
        "/api/moneyprinter/generate",
        json={"invalid": "data"},
        headers=authenticated_headers
    )
    
    assert response.status_code == 422  # Validation error
    data = response.json()
    assert "detail" in data  # FastAPI validation format

def test_authentication_errors():
    """Test authentication error scenarios."""
    # Test missing API key
    response = client.post(
        "/api/moneyprinter/generate",
        json={"videoSubject": "Test subject"}
        # No headers - missing API key
    )
    
    # Should work if API key is optional, or return 401 if required
    assert response.status_code in [200, 401]
    
    # Test invalid API key
    response = client.post(
        "/api/moneyprinter/generate",
        json={"videoSubject": "Test subject"},
        headers={"X-API-Key": "invalid-key"}
    )
    
    if response.status_code == 401:
        assert "Invalid API key" in response.json()["detail"]
```

## 🎭 Frontend Testing

### React Component Testing
Test React components with React Testing Library:

```tsx
import { render, screen, fireEvent, waitFor } from '@testing-library/react'
import { BrowserRouter } from 'react-router-dom'
import CreatorPage from '@/pages/CreatorPage'

// Test utilities
const renderWithRouter = (component: React.ReactElement) => {
  return render(
    <BrowserRouter>
      {component}
    </BrowserRouter>
  )
}

describe('CreatorPage', () => {
  test('renders video generation form', () => {
    renderWithRouter(<CreatorPage />)
    
    expect(screen.getByLabelText(/video subject/i)).toBeInTheDocument()
    expect(screen.getByLabelText(/ai model/i)).toBeInTheDocument()
    expect(screen.getByLabelText(/voice/i)).toBeInTheDocument()
    expect(screen.getByRole('button', { name: /generate video/i })).toBeInTheDocument()
  })
  
  test('handles form submission', async () => {
    // Mock fetch
    global.fetch = jest.fn().mockResolvedValue({
      ok: true,
      json: () => Promise.resolve({ job_id: 'test-123', status: 'queued' })
    })
    
    renderWithRouter(<CreatorPage />)
    
    // Fill form
    fireEvent.change(screen.getByLabelText(/video subject/i), {
      target: { value: 'Test space exploration video' }
    })
    
    // Submit form
    fireEvent.click(screen.getByRole('button', { name: /generate video/i }))
    
    // Wait for API call
    await waitFor(() => {
      expect(global.fetch).toHaveBeenCalledWith(
        expect.stringContaining('/api/moneyprinter/generate'),
        expect.objectContaining({
          method: 'POST',
          headers: expect.objectContaining({
            'Content-Type': 'application/json'
          })
        })
      )
    })
  })
  
  test('displays validation errors', async () => {
    renderWithRouter(<CreatorPage />)
    
    // Try to submit empty form
    fireEvent.click(screen.getByRole('button', { name: /generate video/i }))
    
    // Should show validation message
    await waitFor(() => {
      expect(screen.getByText(/video subject is required/i)).toBeInTheDocument()
    })
  })
})
```

### Hook Testing
Test custom React hooks:

```tsx
import { renderHook, act } from '@testing-library/react'
import { useJobManager } from '@/hooks/useJobManager'

describe('useJobManager', () => {
  test('tracks active jobs', () => {
    const { result } = renderHook(() => useJobManager())
    
    // Initially no jobs
    expect(result.current.getActiveJobs()).toHaveLength(0)
    
    // Start tracking a job
    act(() => {
      result.current.startTracking('job-123')
    })
    
    expect(result.current.getActiveJobs()).toHaveLength(1)
    expect(result.current.getActiveJobs()[0].id).toBe('job-123')
  })
  
  test('updates job progress', () => {
    const { result } = renderHook(() => useJobManager())
    
    act(() => {
      result.current.startTracking('job-123')
    })
    
    act(() => {
      result.current.updateJob('job-123', {
        progress: 50,
        status: 'processing',
        message: 'Generating script'
      })
    })
    
    const job = result.current.getActiveJobs()[0]
    expect(job.progress).toBe(50)
    expect(job.status).toBe('processing')
    expect(job.message).toBe('Generating script')
  })
})
```

