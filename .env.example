# ============================================================================
# REQUIRED API KEYS
# ============================================================================

# PEXELS API KEY - Required for stock video search
PEXELS_API_KEY=your_pexels_api_key_here

# AI API KEYS - At least one is required for text generation
# Google AI API Key (for Gemini models)
GOOGLE_API_KEY=your_google_api_key_here
# Alternative: Gemini API Key (if different from Google API Key)
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================================
# AUTHENTICATION CONFIGURATION (NEW!)
# ============================================================================

# JWT Secret Key - CHANGE THIS IN PRODUCTION!
# Generate a secure random key: openssl rand -hex 32
JWT_SECRET_KEY=your-secret-key-change-this-in-production

# JWT Token Expiration (in minutes)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Authentication Credentials
# For personal deployment, change these to your own username and password
AUTH_USERNAME=admin
AUTH_PASSWORD=tenroller

# ============================================================================
# OPTIONAL SECURITY & AUTHENTICATION
# ============================================================================

# API Key for endpoint protection (optional - leave empty to disable)
# NOTE: This is deprecated in favor of JWT authentication above
API_KEY=

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Database URL (PostgreSQL) - recommended for production
DATABASE_URL=postgresql://videohelper_user:videohelper_password@localhost:5432/videohelper

# ============================================================================
# RATE LIMITING & CORS
# ============================================================================

# Rate limit per minute per IP (0 = disabled)
RATE_LIMIT_PER_MINUTE=60

# CORS allowed origins (comma-separated, * = allow all)
# For production, specify your domain: https://yourdomain.com
CORS_ALLOW_ORIGINS=*

# ============================================================================
# VIDEO PROCESSING CONFIGURATION
# ============================================================================

# Maximum concurrent video generation jobs
# Set to 1 for sequential processing (recommended for resource-constrained machines)
# Increase only if you have sufficient CPU/memory resources
VIDEOHELPER_MAX_CONCURRENT_JOBS=1

# Use streaming mode for video processing (experimental)
VIDEOHELPER_USE_STREAMING=false

# Output directory for generated videos
VIDEOHELPER_OUTPUT_DIR=./output

# ============================================================================
# VIDEO PROCESSOR ORCHESTRATION
# ============================================================================

# Video processor service URLs (comma-separated)
VIDEO_PROCESSOR_URLS=http://localhost:8090

# Video processor API key (if required)
VIDEO_PROCESSOR_API_KEY=

# Backend callback URL for processor to send updates
BACKEND_CALLBACK_URL=http://localhost:9000

# ============================================================================
# LOGGING & MONITORING
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Debug mode (true/false)
DEBUG_MODE=false

# Sentry DSN for error tracking (optional)
SENTRY_DSN=

# ============================================================================
# SECURITY RECOMMENDATIONS FOR PRODUCTION
# ============================================================================
#
# 1. Generate a strong JWT secret:
#    openssl rand -hex 32
#
# 2. Change AUTH_USERNAME and AUTH_PASSWORD to secure values
#
# 3. Use a strong database password in DATABASE_URL
#
# 4. Set specific CORS origins instead of "*"
#    CORS_ALLOW_ORIGINS=https://yourdomain.com
#
# 5. Enable rate limiting:
#    RATE_LIMIT_PER_MINUTE=20
#
# 6. Consider IP whitelisting at your VPS firewall level
#
# 7. Use HTTPS/TLS for your VPS deployment
#
# 8. Regularly update dependencies and monitor for security advisories
#
