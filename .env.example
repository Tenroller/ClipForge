# === Required for Video Generation ===
# Get a free API key at https://www.pexels.com/api/
PEXELS_API_KEY=

# One of these is required for AI script generation (Gemini preferred)
GOOGLE_API_KEY=
GEMINI_API_KEY=

# === Security & API ===
# Optional: protect endpoints. If set, clients must send header: X-API-Key: <value>
API_KEY=
CORS_ALLOW_ORIGINS=*
RATE_LIMIT_PER_MINUTE=60

# === Enhanced Features ===
REDIS_URL=redis://localhost:6379/0
ENABLE_METRICS=true
METRICS_PORT=9090

# === Monitoring & Logging ===
SENTRY_DSN=
LOG_LEVEL=INFO

# === Storage & Performance ===
VIDEOHELPER_OUTPUT_DIR=./cat-video-creator/output
MAX_CONCURRENT_JOBS=4
CACHE_DIR=./cache
MAX_CACHE_SIZE_GB=5

# === Misc ===
TRUSTED_HOSTS=*
