{
  "workflow": "podcastclips",
  "description": "Example PodcastClips job - extracts viral moments from podcast videos",
  "request_data": {
    "youtubeUrl": "https://www.youtube.com/watch?v=P7A0K2q5aEU",
    "aiModel": "gemini-2.5-pro",
    "whisperModel": "base",
    "targetClipCount": 7,
    "minDuration": 20,
    "maxDuration": 70,
    "useGPU": true,
    "subtitleFontSize": 20,
    "subtitleColor": "#FFFFFF",
    "subtitleStrokeColor": "#000000",
    "subtitleStrokeWidth": 2,
    "viralFocusKeywords": ["amazing", "incredible", "shocking"]
  }
}
