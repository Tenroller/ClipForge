# Docker Environment Configuration for AI Video Generator
# Copy this file to .env and update with your actual values
# Only includes Gemini AI integration - simplified configuration

# ===========================================
# REQUIRED - AI Service API Keys
# ===========================================
# Pexels API for stock video search (REQUIRED)
PEXELS_API_KEY=your_pexels_api_key_here

# Gemini API Key (REQUIRED - for text generation)
GEMINI_API_KEY=your_gemini_api_key_here

# ===========================================
# Database Configuration (PostgreSQL)
# ===========================================
DATABASE_URL=postgresql://videohelper_user:videohelper_secure_pass_2024@postgres:5432/videohelper
POSTGRES_DB=videohelper
POSTGRES_USER=videohelper_user
POSTGRES_PASSWORD=videohelper_secure_pass_2024

# ===========================================
# Redis Configuration
# ===========================================
REDIS_URL=redis://redis:6379
REDIS_DB=1

# ===========================================
# Backend API Configuration
# ===========================================
HOST=0.0.0.0
PORT=9000
CORS_ALLOW_ORIGINS=http://localhost:3000,http://frontend
VIDEO_PROCESSOR_URLS=http://video-processor:8090
BACKEND_API_KEY=your_secure_api_key_here

# ===========================================
# Video Processor Configuration
# ===========================================
PROCESSOR_HOST=0.0.0.0
PROCESSOR_PORT=8090
BACKEND_API_URL=http://backend:9000
OUTPUT_DIR=/app/output
TEMP_DIR=/app/temp

# ===========================================
# TTS Configuration
# ===========================================
ESPEAK_PATH=/usr/bin/espeak-ng
DATA_PATH=/usr/share/espeak-ng-data

# ===========================================
# Security & Authentication
# ===========================================
JWT_SECRET_KEY=your-very-secure-jwt-secret-key-change-this-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===========================================
# Application Configuration
# ===========================================
LOG_LEVEL=INFO
DEBUG_MODE=false
MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT_SECONDS=3600
RATE_LIMIT_PER_MINUTE=60

# ===========================================
# Database Pool Configuration
# ===========================================
VIDEOHELPER_DB_POOL_SIZE=10
VIDEOHELPER_DB_POOL_TIMEOUT=60

# ===========================================
# Cleanup Configuration
# ===========================================
VIDEOHELPER_TEMP_CLEANUP_INTERVAL=30
VIDEOHELPER_TEMP_MAX_AGE_HOURS=24
VIDEOHELPER_STREAMING_CLEANUP_HOURS=1

# ===========================================
# NOTES:
# ===========================================
# 1. Replace all "your_*" placeholders with actual values
# 2. Get your Gemini API key from: https://makersuite.google.com/app/apikey
# 3. Get your Pexels API key from: https://www.pexels.com/api/
# 4. Keep this file secure and never commit it to version control
# 5. For production, always set secure JWT_SECRET_KEY and BACKEND_API_KEY